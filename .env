WEB_API_KEY=API KEY HERE
WEB_API_URL="https://api.tavily.com/search"


# ----------------------------
# Metadata DB (Mongo)
# ----------------------------
METADATA_DB_TYPE=mongo
# for docker use mongodb, localhost for local
METADATA_DB_URL=mongodb://localhost:27017
METADATA_DB_NAME=mcp_db
METADATA_COLLECTION_NAME=products

#executor-microservice for docker and localhost otherwhise
EXECUTOR_TARGET_ADDRESS=localhost:50051

EMBEDDING_TARGET_ADDRESS=localhost:8080

# LLM
LLM_API_KEY=API KEY HERE
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MAX_TOKENS=256
LLM_MODEL=llama-3.1-8b-instant

EMBEDDING_MODEL="all-MiniLM-L6-v2"

VECTOR_DB_DIM=384
VECTOR_TOP_K=3




